<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Local folder feed for the licensed Telerik package(s). Copy the
      Telerik.UI.for.AspNet.Core.2023.2.606.nupkg file into this folder on the
      build/IIS server (IS-VBOXX02). No credentials needed for a local folder.
      Create the folder if it does not exist and drop the .nupkg in it.
    -->
    <add key="TelerikLocal" value="C:\LocalNuGet" />
  </packageSources>
</configuration>
