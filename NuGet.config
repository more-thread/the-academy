<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Private feed that hosts Telerik.UI.for.AspNet.Core. -->
    <add key="TelerikFeed" value="https://nuget.telerik.com/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceCredentials>
    <!--
      Credentials are read from environment variables at restore time so no
      secrets are committed. Set TELERIK_USERNAME / TELERIK_PASSWORD as *secret*
      pipeline variables (or in a variable group) and map them into the restore
      step's env: block. Locally, either set the same env vars or let your
      user-level NuGet.config supply the Telerik credentials.
    -->
    <TelerikFeed>
      <add key="Username" value="%TELERIK_USERNAME%" />
      <add key="ClearTextPassword" value="%TELERIK_PASSWORD%" />
    </TelerikFeed>
  </packageSourceCredentials>
</configuration>
